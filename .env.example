# Copy this file to .env and adjust the values for this machine.
# .env is gitignored — each machine (your Mac, the client's PC) keeps its own.

# Port the app listens on (serves both the API and the built frontend)
PORT=5050

# REQUIRED when NODE_ENV=production. Signs the login session cookie; everyone
# is logged out if it changes, and the app refuses to start in production
# without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development the app generates one and caches it next to the database.
SESSION_SECRET=

# Set to "production" on the machine that actually runs the app for the
# client. Among other things this turns on secure cookies and stops internal
# error messages being sent to the browser.
# NODE_ENV=production

# Where the SQLite database file lives on this machine.
# Leave commented to use ./payroll.db in the project folder.
# DB_PATH=./payroll.db

# Where `npm run backup` and the automatic pre-migration backups are written.
# Defaults to ./backups.
# BACKUP_DIR=./backups

# Folder containing the legacy "PunchWay" Excel files (monthly paysheets +
# "blank pay sheet.xlsx"). Only read for the admin "email payroll" address
# lookup and the one-time legacy import (npm run migrate-legacy).
# Defaults to ~/Desktop/PunchWay if not set.
PUNCHWAY_DATA_DIR=/absolute/path/to/PunchWay

# How long a login lasts before it has to be repeated (default 12 hours).
# SESSION_TTL_MS=43200000

# A shift longer than this is refused as a forgotten clock-out rather than
# being paid out (default 24 hours).
# MAX_SHIFT_HOURS=24

# Extra browser origins allowed to call the API. Only needed for frontend
# development against a separate Vite dev server.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# trace | debug | info | warn | error | silent
# LOG_LEVEL=info
